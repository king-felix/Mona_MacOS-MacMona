{
  "name": "mona",
  "productName": "Mona",
  "version": "0.1.0-p02",
  "private": true,
  "description": "Mona \u2014 a native Apple Silicon workbench for the Codewhale engine",
  "license": "UNLICENSED",
  "main": "dist/main/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "clean": "rm -rf dist coverage",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/build-supervisor.mjs && node scripts/build-pty.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "node scripts/ci.mjs",
    "engine:smoke": "npm run build && npm run build:supervisor && node scripts/engine-smoke.mjs",
    "build:supervisor": "node scripts/build-supervisor.mjs",
    "build:pty": "node scripts/build-pty.mjs",
    "build:service": "node scripts/build-service.mjs",
    "smoke:lifecycle": "npm run build && node scripts/lifecycle-smoke.mjs",
    "smoke:shell": "npm run build && node scripts/shell-smoke.mjs",
    "smoke:history": "npm run build && node scripts/history-smoke.mjs",
    "smoke:commands": "npm run build && node scripts/command-smoke.mjs",
    "smoke:immersive": "npm run build && node scripts/immersive-smoke.mjs",
    "smoke:aurora": "npm run build && node scripts/aurora-smoke.mjs",
    "smoke:pending": "npm run build:main && node scripts/pending-smoke.mjs",
    "icon:render": "node packaging/macos/icon.mjs --mark src/renderer/assets/mona-mark.png",
    "smoke:commands:live": "npm run build:main && node scripts/command-execute-smoke.mjs",
    "smoke:studio": "npm run build && node scripts/studio-smoke.mjs",
    "smoke:service": "node scripts/service-smoke.mjs",
    "smoke:open": "node scripts/open-smoke.mjs",
    "smoke:board": "npm run build:main && node scripts/board-smoke.mjs",
    "smoke:cost": "npm run build:main && node scripts/cost-smoke.mjs",
    "smoke:changes": "npm run build:main && node scripts/changes-smoke.mjs",
    "smoke:polish": "npm run build:main && node scripts/polish-smoke.mjs",
    "smoke:agents": "npm run build:main && npm run build:supervisor && node scripts/agents-smoke.mjs",
    "smoke:settings": "npm run build:main && node scripts/settings-smoke.mjs",
    "smoke:extensions": "npm run build:main && node scripts/extensions-smoke.mjs",
    "smoke:terminal": "npm run build:main && npm run build:pty && node scripts/terminal-smoke.mjs",
    "smoke:capability": "npm run build:main && node scripts/capability-smoke.mjs",
    "catalog:capture": "node scripts/command-catalog.mjs --capture",
    "catalog:check": "node scripts/command-catalog.mjs --check",
    "catalog:coverage": "node scripts/command-catalog.mjs --coverage",
    "smoke:memory": "npm run build:main && node scripts/memory-smoke.mjs",
    "smoke:failure": "npm run build:main && node scripts/p20-failure-smoke.mjs",
    "smoke:p23": "npm run build:main && node scripts/p23-lifecycle-smoke.mjs",
    "mac:doctor": "node packaging/macos/doctor.mjs",
    "mac:package:local": "node packaging/macos/build.mjs --mode local",
    "mac:package:release": "node packaging/macos/build.mjs --mode release",
    "smoke:agents-live": "npm run build:main && npm run build:supervisor && node scripts/agents-smoke.mjs --live"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.14.0",
    "electron": "45.3.0",
    "eslint": "10.15.0",
    "jsdom": "^31.0.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
