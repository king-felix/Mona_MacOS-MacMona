    "advisor": {
      "scope": "thread",
      "sideEffects": ["thread-state", "spend"],
      "cost": "may-spend",
      "support": "terminal-only",
      "route": {
        "kind": "tui-local",
        "note": "Toggles the session advisor in TUI state; no Runtime API operation documented."
      }
    },
    "agent": {
      "scope": "thread",
      "sideEffects": ["thread-state", "spend"],
      "cost": "may-spend",
      "support": "terminal-only",
      "route": {
        "kind": "tui-local",
        "note": "Creates a persistent sub-agent session through a TUI turn; /v1/agent-runs only inspects and cancels existing runs."
      }
    },
    "anchor": {
      "scope": "thread",
      "sideEffects": ["thread-state"],
      "cost": "none",
      "support": "terminal-only",
      "route": {
        "kind": "tui-local",
        "note": "Session-scoped context anchors live in the TUI; no Runtime API operation documented."
      }
    },
    "attach": {
      "scope": "thread",
      "sideEffects": ["thread-state"],
      "cost": "none",
      "support": "unavailable",
      "route": {
        "kind": "unavailable",
        "note": "Mona's composer does not attach media (RV-13); typed turns accept image input but this command is TUI-only."
      }
    },
    "auth": {
      "scope": "account",
      "sideEffects": ["credential-change", "network"],
      "cost": "none",
      "support": "terminal-only",
      "route": {
        "kind": "tui-local",
        "note": "Browser OAuth flows belong to the TUI; provider API keys are the only credential route Mona exposes, through P16 settings."
      }
    },
    "auto": {
      "scope": "thread",
      "sideEffects": ["thread-state", "spend"],
      "cost": "unknown",
      "support": "terminal-only",
      "route": {
        "kind": "tui-local",
        "note": "Auto-Review is a TUI workflow surface; the engine exposes no Runtime API operation for it on 0.10.2."
      }
    },
    "automation": {
