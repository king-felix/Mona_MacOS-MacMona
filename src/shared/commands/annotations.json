      "sideEffects": ["config-write", "spend"],
      "cost": "may-spend",
      "support": "runtime-api",
      "route": {
        "kind": "runtime-api",
        "endpoints": [
          "/v1/automations/{id}/pause",
          "/v1/automations/{id}/resume",
          "/v1/automations/{id}/run",
          "/v1/automations/{id}/runs"
